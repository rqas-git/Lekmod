
#include <algorithm>
#include <cassert>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <iostream>
#include <new>
#include <random>
#include <vector>
static long long allocations=0, techReads=0, missionReads=0;
void* operator new(std::size_t n){++allocations;if(void* p=std::malloc(n?n:1))return p;throw std::bad_alloc();}
void operator delete(void* p) noexcept{std::free(p);}
void* operator new(std::size_t n,const std::nothrow_t&) noexcept{try{return ::operator new(n);}catch(...){return NULL;}}
void operator delete(void* p,const std::nothrow_t&) noexcept{std::free(p);}
typedef unsigned int uint;
typedef int PlayerTypes;
const int MAX_MAJOR_CIVS=64;
#define CvAssertMsg(a,b) ((void)0)
struct Techs {int known;int GetNumTechsKnown(){++techReads;return known;}};
struct Team {Techs techs;Techs* GetTeamTechs(){return &techs;}} teams[64];
struct Player {int id,team;bool alive;int getTeam(){return team;}int GetID(){return id;}bool isAlive(){return alive;}} players[64];
#define GET_PLAYER(i) players[i]
#define GET_TEAM(i) teams[i]
struct CurrentTechs {int player;Player* GetPlayer(){return &players[player];}};
struct CvTechAI {CurrentTechs* m_pCurrentTechs;float GetTechRatio();float LinearTechRatio();};
@TECH_STRUCTS@
@TECH_BASELINE@
@TECH_LINEAR@
typedef int MissionAITypes;
struct CvPlot {int x,y;int getX(){return x;}int getY(){return y;}};
int plotDistance(int ax,int ay,int bx,int by){int x=bx-ax,y=by-ay;return ((x>=0)==(y>=0))?std::abs(x)+std::abs(y):std::max(std::abs(x),std::abs(y));}
struct CvUnit {CvPlot* mission;int type;CvPlot* GetMissionAIPlot(){++missionReads;return mission;}int GetMissionAIType(){return type;}};
struct CvPlayerAI {
    std::vector<CvUnit> units;
    CvUnit* firstUnit(int* i){*i=0;return units.empty()?NULL:&units[0];}
    CvUnit* nextUnit(int* i){++*i;return *i<int(units.size())?&units[*i]:NULL;}
    int AI_plotTargetMissionAIs(CvPlot*,MissionAITypes,int);
    bool HasPlotTargetMissionAI(CvPlot*,MissionAITypes,int);
};
@MISSION_BASELINE@
@MISSION_BOOLEAN@
struct ReverseSort {bool operator()(unsigned char a,unsigned char b)const{return a>b;}};
int main(){
    std::mt19937 rng(694032);CurrentTechs current;CvTechAI ai;ai.m_pCurrentTechs=&current;
    long long techCases=0,oldAlloc=0,newAlloc=0;
    for(int world=0;world<2000;++world){
        for(int p=0;p<64;++p){players[p]={p,int(rng()%64),rng()%3!=0};teams[p].techs.known=int(rng()%15);}

        if(world<2)for(int p=0;p<64;++p)players[p].alive=(world==1&&p==0);
        for(int p=0;p<64;++p){
            current.player=p;allocations=techReads=0;
            float old=ai.GetTechRatio();oldAlloc+=allocations;const auto beforeReads=techReads;
            allocations=techReads=0;float now=ai.LinearTechRatio();newAlloc+=allocations;
            assert(std::memcmp(&old,&now,sizeof(float))==0&&beforeReads==techReads);++techCases;
        }
    }
    long long missionCases=0,oldMission=0,newMission=0;
    CvPlayerAI player;std::vector<CvPlot> plots(64);
    for(int i=0;i<64;++i)plots[i]={i%8,i/8};
    for(int n:{0,1,2,8,64,256})for(int trial=0;trial<100;++trial){
        player.units.clear();for(int i=0;i<n;++i)player.units.push_back({rng()%8?&plots[rng()%64]:NULL,int(rng()%3)});
        for(auto& plot:plots)for(int range:{-1,0,1,3}){
            missionReads=0;bool old=player.AI_plotTargetMissionAIs(&plot,1,range)>0;oldMission+=missionReads;
            missionReads=0;bool now=player.HasPlotTargetMissionAI(&plot,1,range);newMission+=missionReads;
            assert(old==now);++missionCases;
        }
    }
    long long sortCases=0,stableAlloc=0,unstableAlloc=0;
    unsigned char original[37],a[37],b[37];
    for(int n=0;n<=37;++n)for(int trial=0;trial<200;++trial){
        for(int i=0;i<n;++i)original[i]=static_cast<unsigned char>(rng());
        std::memcpy(a,original,n);std::memcpy(b,original,n);
        allocations=0;std::stable_sort(a,a+n,ReverseSort());stableAlloc+=allocations;
        allocations=0;std::sort(b,b+n,ReverseSort());unstableAlloc+=allocations;
        assert(std::memcmp(a,b,n)==0);++sortCases;
    }


    int wideMismatches=0;
    for(int trial=0;trial<200;++trial){
        std::vector<unsigned int> wide(37);for(auto& v:wide)v=rng()%1024;
        auto other=wide;std::stable_sort(wide.begin(),wide.end(),ReverseSort());std::sort(other.begin(),other.end(),ReverseSort());
        if(wide!=other)++wideMismatches;
    }
    std::cout<<"{\"tech_cases\":"<<techCases<<",\"tech_allocations\":["<<oldAlloc<<","<<newAlloc
        <<"],\"mission_cases\":"<<missionCases<<",\"mission_unit_reads\":["<<oldMission<<","<<newMission
        <<"],\"scalar_sort_cases\":"<<sortCases<<",\"scalar_sort_allocations\":["<<stableAlloc<<","<<unstableAlloc
        <<"],\"wide_sort_mismatches\":"<<wideMismatches<<"}";
}
