            VALUE "OriginalFilename", "CvGameCoreDLL.dll"
            VALUE "ProductName", "Sid Meier's Civilization V"
            VALUE "ProductVersion", "3, 0, 3, 1"
        END
    END
    BLOCK "VarFileInfo"
