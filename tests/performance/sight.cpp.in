#include <algorithm>
#include <cassert>
#include <iostream>
#include <random>
#include <utility>
#include <vector>
typedef int PromotionTypes;
static long long promotionReads=0, rangeChecks=0;
struct CvPromotionEntry {
    int value;
    int GetVisibilityChange()const{++promotionReads;return value;}
    static int GetTotalVisibilityChange();
    static void InvalidateVisibilityChangeCache();
};
struct Globals {
    int visibility=1,recon=6;
    std::vector<CvPromotionEntry*> entries;
    int getNumPromotionInfos(){return static_cast<int>(entries.size());}
    CvPromotionEntry* getPromotionInfo(PromotionTypes p){return entries.at(p);}
    int getUNIT_VISIBILITY_RANGE(){return visibility;}
    int getRECON_VISIBILITY_RANGE(){return recon;}
} GC;
static int s_iPromotionVisibilityChange=0;
static bool s_bPromotionVisibilityChangeValid=false;
@INVALIDATE@
@AGGREGATE@
struct CvPlot {
    int x,y,id;
    int getX(){return x;} int getY(){return y;}
    void updateSight(bool increment);
    void baseline(bool bIncrement);
    void updateSeeFromSight(bool bIncrement);
};
std::vector<std::pair<int,bool>> trace;
std::vector<CvPlot> plots;
int width,height;bool wrap;
void CvPlot::updateSight(bool increment){trace.push_back({id,increment});}
CvPlot* plotXY(int x,int y,int dx,int dy){
    x+=dx;y+=dy;
    if(wrap){x=(x%width+width)%width;y=(y%height+height)%height;}
    if(x<0||y<0||x>=width||y>=height)return NULL;
    return &plots.at(y*width+x);
}
@RANGE_CHECK@
@BASELINE@
@CURRENT@
int main(){
    std::mt19937 rng(2971);long long cases=0,beforeReads=0,afterReads=0,validVisits=0;
    std::vector<CvPromotionEntry> promotions(100);
    for(int n:{0,1,2,10,100})for(int reload=0;reload<20;++reload){
        GC.entries.clear();
        for(int i=0;i<n;++i){promotions[i].value=static_cast<int>(rng()%7)-3;GC.entries.push_back(i%9?&promotions[i]:NULL);}
        CvPromotionEntry::InvalidateVisibilityChangeCache();
        for(int dims:{1,2,7,17})for(int wrapped=0;wrapped<2;++wrapped)for(int increment=0;increment<2;++increment){
            width=dims;height=dims+1;wrap=wrapped;plots.clear();
            for(int y=0;y<height;++y)for(int x=0;x<width;++x)plots.push_back({x,y,y*width+x});

            GC.visibility=static_cast<int>(rng()%15)-5;GC.recon=static_cast<int>(rng()%15)-5;
            CvPlot& plot=plots.at(rng()%plots.size());
            trace.clear();promotionReads=0;plot.baseline(increment);
            beforeReads+=promotionReads;const auto baseline=trace;
            trace.clear();promotionReads=0;plot.updateSeeFromSight(increment);
            afterReads+=promotionReads;assert(baseline==trace);
            validVisits+=trace.size();++cases;
        }
    }
    assert(afterReads<beforeReads);
    std::cout<<"{\"cases\":"<<cases<<",\"sight_events\":"<<validVisits
        <<",\"promotion_reads\":["<<beforeReads<<","<<afterReads<<"],\"removed_range_checks\":"<<rangeChecks<<"}";
}
